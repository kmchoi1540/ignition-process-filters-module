          "tagType": "UdtType",
          "tags": [
            {
              "valueSource": "memory",
              "eventScripts": [
                {
                  "eventid": "valueChanged",
                  "script": "\tsystem.tag.writeAsync([\"[.]EN\"],[False])"
                }
              ],
              "engHigh": 100.0,
              "documentation": "1: CurrentWeightedMovingAverageFilter,\n2:WeightedMovingAverageFilter,\n3:ButterworthIIRFilter\nRest: No Filter",
              "name": "Mode",
              "tooltip": "1: CurrentWeightedMovingAverageFilter, 2:WeightedMovingAverageFilter, 3:ButterworthIIRFilter",
              "engLimitMode": "No_Clamp",
              "value": 0,
              "tagType": "AtomicTag"
            },
            {
              "valueSource": "memory",
              "documentation": "Storing size of datapoints",
              "name": "Size",
              "tooltip": "Storing size of datapoints",
              "value": 100,
              "tagType": "AtomicTag"
            },
            {
              "executionRate": {
                "bindType": "parameter",
                "binding": "{Interval}"
              },
              "valueSource": "expr",
              "expression": "customFilter(\r\n  {[.]EN},\r\n  {[.]Mode},\r\n  {[.]Size},\r\n  case(\r\n    {[.]Mode},\r\n    1, {[.]Args/CMAArg},\r\n    2, {[.]Args/WMAArg},\r\n    3, {[.]Args/IIRArg},\r\n    4,\r\n      jsonSet({[.]Args/KMArg},\"value[0]\",{[.]Interval}),\r\n    \"\"\r\n  ),\r\n  storeData(\r\n    {[.]EN} \u0026\u0026 ({[.]Mode} \u003e 0) \u0026\u0026 ({[.]Mode} \u003c 5),\r\n    {[.]Size},\r\n    {[.]PV},\r\n    \"[\" + {DeviceName} + \"]\" + {PathToParentFolder}\r\n  ),\r\n  \"[\" + {DeviceName} + \"]\" + {PathToParentFolder}\r\n)",
              "documentation": "Filtered PV (Manipulated Value)",
              "sourceTagPath": "",
              "tooltip": "Filtered PV (Manipulated Value)",
              "tagGroup": "PID",
              "tagType": "AtomicTag",
              "dataType": "Float8",
              "historyProvider": "",
              "name": "MV",
              "historyEnabled": false,
              "executionMode": "FixedRate",
              "sampleMode": "Periodic",
              "historySampleRate": 1
            },
            {
              "documentation": "Filter Arguments",
              "name": "Args",
              "tooltip": "Filter Arguments",
              "tagType": "Folder",
              "tags": [
                {
                  "valueSource": "memory",
                  "dataType": "Document",
                  "documentation": "WeightedMovingAverageFilter Parameters\n• windowSize (Window Size) — Defines the number of most recent samples used for averaging.\nMust be greater than 0.\n• The filter assigns linearly increasing weights to newer samples, giving more importance to recent values.\n• Larger window sizes yield smoother but slower responses, while smaller sizes make the filter more reactive but noisier.\n• Typical range: 3–20 samples, depending on data noise and update frequency.",
                  "name": "WMAArg",
                  "tooltip": "Weighted Moving Average Parameters — windowSize: number of samples (\u003e 0)",
                  "value": {
                    "value": [
                      10
                    ]
                  },
                  "tagType": "AtomicTag"
                },
                {
                  "valueSource": "memory",
                  "dataType": "Document",
                  "documentation": "Butterworth IIR Filter Parameters\n• fs (Sampling Rate) — Must be positive (fs \u003e 0). Defines how frequently data points are sampled, in Hertz (Hz).\nTypical range: 1–10 Hz for slow process data, 10–100 Hz for faster sensor or vibration signals.\n• fc (Cutoff Frequency) — Must be below half of fs (Nyquist limit). Controls the smoothing strength; higher fc values allow faster response but reduce noise suppression.\nTypical range: 5–30 % of fs, depending on the desired smoothness.\n• adaptGain (Adaptive Gain, optional) — Controls how strongly the cutoff frequency adapts to signal variance. Valid range: 0 \u003c adaptGain \u003c 1.\nHigher adaptGain → faster adaptation but potentially noisier output.\nTypical range: 0.05–0.3 for most process signals.\n• For a fixed (non-adaptive) filter, provide only [fs, fc].\n• For adaptive filtering, provide [fs, fc, adaptGain].",
                  "name": "IIRArg",
                  "tooltip": "Butterworth IIR Filter Parameters — fs: sampling rate, fc: cutoff frequency, adaptGain: adaptive responsiveness (0 \u003c adaptGain \u003c 1).",
                  "value": {
                    "value": [
                      100,
                      10
                    ]
                  },
                  "tagType": "AtomicTag"
                },
                {
                  "valueSource": "memory",
                  "dataType": "Document",
                  "documentation": "KalmanFilter Parameters\n• dt (Time Interval) — Time interval between consecutive data points, in milliseconds.\nWhen used inside an expression tag, this value is automatically populated(Recommend to manually modify \u0027Interval\u0027) — leave this field empty in that case.\nTypical range: 500–2000 ms for slow process data; match to your scan class rate.\n• Q (Acceleration Variance) — Governs how aggressively the filter reacts to changes in signal trend.\nHigher values → faster response but noisier output.\nTypical range: 1e-4 – 1e-2 for most process variables.\n• R (Measurement Noise Variance) — Governs the filter’s resistance to sensor noise.\nHigher values → smoother output but slower response.\nTypical range: 1e-3 – 1e-1, depending on signal noise level.",
                  "name": "KMArg",
                  "tooltip": "Kalman Filter Parameters — dt: data interval (ms), Q: acceleration variance, R: measurement noise variance.",
                  "value": {
                    "value": [
                      "leave empty",
                      0.01,
                      0.1
                    ]
                  },
                  "tagType": "AtomicTag"
                },
                {
                  "valueSource": "memory",
                  "dataType": "Document",
                  "documentation": "CurrentWeightedMovingAverageFilter Parameters\n• weight (Current Weight) — Defines how much influence the most recent value has compared to the previous average.\nValid range: 0 ≤ weight ≤ 1.\nweight \u003d 1.0 → output equals current input (no smoothing).\nweight \u003d 0.0 → output remains at previous value (no update).\nTypical values (0.2 – 0.8) balance responsiveness and smoothness.\n• Smaller weights smooth the signal more but increase lag; larger weights react faster but increase noise.",
                  "name": "CMAArg",
                  "tooltip": "Current Weighted Moving Average Parameters — weight: 0 ≤ weight ≤ 1",
                  "value": {
                    "value": [
                      0.8
                    ]
                  },
                  "tagType": "AtomicTag"
                }
              ]
            },
            {
              "sourceTagPath": {
                "bindType": "parameter",
                "binding": "{TagIn}"
              },
              "valueSource": "reference",
              "dataType": "Float8",
              "historyProvider": "",
              "documentation": "Original Process Value",
              "name": "PV",
              "tooltip": "Original Process Value",
              "historyEnabled": false,
              "sampleMode": "Periodic",
              "historySampleRate": 1,
              "tagType": "AtomicTag"
            },
            {
